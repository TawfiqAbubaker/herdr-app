# Track only personal Herdr settings and custom clones; ignore app state/defaults.
/*
!/.gitignore
!/README.md
!/keys.json
!/layouts/
/layouts/*
!/layouts/UFCisco.json
!/mods/
/mods/*
!/mods/spaces-indexed/
/mods/spaces-indexed/*
!/mods/spaces-indexed/main.js
!/mods/spaces-indexed/mod.json
!/mods/spaces-indexed/jsconfig.json
!/mods/spaces-indexed/*.svg
!/mods/tabs-indexed/
/mods/tabs-indexed/*
!/mods/tabs-indexed/main.js
!/mods/tabs-indexed/mod.json
!/mods/tabs-indexed/jsconfig.json
!/mods/tabs-indexed/*.svg

!/mods/spaces-indexed/fighters.js
!/mods/spaces-indexed/*.png
!/mods/spaces-indexed/fighters/
!/mods/spaces-indexed/space-menus.js
!/mods/agents-fighters/
!/mods/spaces-indexed/country-wash.js
!/mods/spaces-indexed/flag-controls.js

!/mods/ufc-chrome/
/mods/ufc-chrome/*
!/mods/ufc-chrome/main.js
!/mods/ufc-chrome/mod.json
!/mods/ufc-chrome/*.svg
/mods/agents-fighters/*.d.ts
